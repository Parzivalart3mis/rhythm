# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Database (Neon Postgres)
DATABASE_URL=

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cron protection — also sent to cron-job.org as the job's Authorization header
CRON_SECRET=

# cron-job.org (external scheduler). With an API key the app keeps the job's
# firing times in sync with the timetable; without one it never calls out and
# whatever schedule the job already has is left alone.
CRONJOB_ORG_API_KEY=
# Canonical origin the scheduler should call. Falls back to
# VERCEL_PROJECT_PRODUCTION_URL on Vercel. Never VERCEL_URL — that changes per deploy.
NEXT_PUBLIC_APP_URL=
# Optional overrides.
CRON_TARGET_URL=                     # full URL, if it isn't <origin>/api/cron/send-reminders
CRONJOB_ORG_JOB_ID=                  # adopt a specific existing job instead of matching by URL
CRONJOB_ORG_JOB_TITLE=               # defaults to "Rhythm — reminder dispatch"

# Sentry (optional)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
